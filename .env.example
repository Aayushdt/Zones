# Public browser configuration. These VITE_ values are included in the client bundle.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_MAP_STYLE_URL=

# Supabase project settings used by the Edge Function; URL and anon key are public.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Supabase Edge Function secrets only. Never use the VITE_ prefix for these values.
# Service-role keys and signing/HMAC secrets must never reach the browser.
SUPABASE_SERVICE_ROLE_KEY=
JOIN_CODE_HMAC_SECRET=
RATE_LIMIT_HASH_SECRET=
